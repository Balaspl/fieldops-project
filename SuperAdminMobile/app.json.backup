{
  "expo": {
    "name": "FieldOps Staff",
    "slug": "fieldops-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fieldopsstaff",
    "icon": "./assets/brand/technician_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fieldops.staff"
    },
    "android": {
      "package": "com.fieldops.staff",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/technician_icon.png",
        "backgroundColor": "#EAF4EE"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
