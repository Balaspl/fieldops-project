{
  "name": "fieldops-staff-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:standalone": "cd android && gradlew.bat -PhermesEnabled=false -PreactNativeArchitectures=arm64-v8a,x86_64 assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "start:clear": "expo start --dev-client --clear --port 8082"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "expo": "^57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "lucide-react-native": "1.72.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
