# Use http://10.0.2.2:8000 for the Android emulator when the backend runs on the same PC.
# For a physical device, use your development PC's reachable LAN IP, e.g. http://192.168.1.20:8000.
# Use an HTTPS endpoint for staging/production builds.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_APP_ENV=development

