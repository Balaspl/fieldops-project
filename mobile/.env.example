
# FieldOps Mobile — local development template
# Copy this file to .env, then set URLs appropriate to your device.
# Never store passwords, access tokens, API keys, or other secrets here.

# Local development environment
EXPO_PUBLIC_APP_ENV=development

# Android Studio emulator accessing a backend on the same computer.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:8000

# For a physical device, replace 10.0.2.2 with your computer's
# LAN IP address and ensure the backend/firewall allows the connection.
#
# For EAS cloud builds, configure these variables separately in the
# EAS development, preview (staging), and production environments.
# Production must use a public HTTPS API URL and WSS WebSocket URL.
