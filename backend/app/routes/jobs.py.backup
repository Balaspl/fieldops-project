        Job.tenant_id == tenant_id,
    )"""
)

# ---------------------------------------------------------
# 23. FINAL SAFETY CHECK
# ---------------------------------------------------------
forbidden_patterns = [
    "if not user or not user.is_super_admin:",
    "if not user.is_super_admin:",
    "if not current_user.is_super_admin:",
    "if user.is_super_admin and job.tenant_id:",
    "effective_tenant = tenant_id if (user and not user.is_super_admin)",
]

remaining = [
    pattern
    for pattern in forbidden_patterns
    if pattern in text
]

if remaining:
    print("\nWARNING: These tenant-bypass patterns still remain:")
    for pattern in remaining:
        print(f"  - {pattern}")

    # Restore original file because update is incomplete.
    shutil.copy2(BACKUP, FILE)
    raise RuntimeError("Update aborted. Original jobs.py restored.")

# ---------------------------------------------------------
# 24. SYNTAX VALIDATION
# ---------------------------------------------------------
try:
    ast.parse(text)
except SyntaxError as exc:
    shutil.copy2(BACKUP, FILE)
    raise RuntimeError(
        f"Syntax error after update at line {exc.lineno}: {exc.msg}. "
        "Original jobs.py restored."
    ) from exc

# ---------------------------------------------------------
# 25. WRITE UPDATED FILE
# ---------------------------------------------------------
FILE.write_text(text, encoding="utf-8")

print("\n===================================================")
print("jobs.py tenant isolation update completed.")
print("===================================================")
print(f"Updated file : {FILE}")
print(f"Backup file  : {BACKUP}")
print("Syntax       : PASS")
print("Tenant bypasses remaining : NONE")
print("===================================================")